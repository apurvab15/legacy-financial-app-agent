{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.interface.ai/schemas/capability.schema.json",
  "title": "Capability artifact",
  "description": "Phase 0 stub. Validates the locked lookup-savings-balance example in docs/CONTRACT.md. Discovery (Phase 4) and the hand-written Phase 2 skill must emit this shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "name",
    "version",
    "description",
    "app",
    "input_schema",
    "output_schema",
    "risk",
    "checkpoint",
    "known_outcomes",
    "steps"
  ],
  "properties": {
    "apiVersion": {
      "const": "capability.interface.ai.local/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "entry", "origin_allowlist"],
      "properties": {
        "surface": {
          "type": "string",
          "enum": ["web"]
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "origin_allowlist": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https?://(127\\.0\\.0\\.1|localhost)(:[0-9]+)?$"
          }
        }
      }
    },
    "input_schema": {
      "type": "object",
      "description": "JSON Schema for invoke params. Locked lookup example requires member_id."
    },
    "output_schema": {
      "type": "object",
      "description": "JSON Schema for outputs. Locked lookup example allows member_name and savings_balance."
    },
    "risk": {
      "type": "string",
      "enum": ["safe", "reversible", "irreversible"]
    },
    "checkpoint": {
      "$ref": "#/$defs/detect"
    },
    "known_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "detect"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "detect": {
            "$ref": "#/$defs/detect"
          }
        }
      }
    },
    "tenant": {
      "type": "object",
      "description": "Optional 3.7 stub. Empty overlays in MVP.",
      "additionalProperties": false,
      "required": ["app_family"],
      "properties": {
        "app_family": {
          "type": "string"
        },
        "overlays": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "detect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["role_name_visible", "text_visible"]
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "role_name_visible" } }
          },
          "then": {
            "required": ["role", "name"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "text_visible" } }
          },
          "then": {
            "required": ["text"]
          }
        }
      ]
    },
    "locatorStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["role", "nearby_text", "accessible_name", "css"]
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "css": {
          "type": "string",
          "description": "Last-resort only. Never the first strategy on a target."
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "target"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": ["fill", "click", "extract"]
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frame", "strategies"],
          "properties": {
            "frame": {
              "type": "string",
              "minLength": 1
            },
            "strategies": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/locatorStrategy"
              }
            }
          }
        },
        "input_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "key"],
          "properties": {
            "from": {
              "const": "input"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "output_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key"],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "wait": {
          "type": "object",
          "description": "Optional. Phase 2 may add timeouts without bumping apiVersion."
        },
        "on_error": {
          "type": "string",
          "enum": ["fail", "escalate", "classify_outcome"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "action": { "const": "fill" } }
          },
          "then": {
            "required": ["input_binding"]
          }
        },
        {
          "if": {
            "properties": { "action": { "const": "extract" } }
          },
          "then": {
            "required": ["output_binding"]
          }
        }
      ]
    }
  }
}
