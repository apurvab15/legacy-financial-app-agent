# Copy to .env (gitignored). Discovery only — replay never needs a key.
# Google Gemini via its OpenAI-compatible endpoint.
GEMINI_API_KEY=
# gemini-2.5-flash is the code default but is closed to new API keys; newer keys
# must name a current flash model here. Check with GET $DISCOVERY_BASE_URL/models.
# Free tier allows 20 requests per day PER MODEL, and one discovery run costs
# about 5, so switch to another flash model when a day's quota runs out.
DISCOVERY_MODEL=gemini-3.5-flash
# Tried in order when the model above is saturated (503) or out of daily quota.
# Comma-separated; unset uses the built-in chain in src/llm.py.
# DISCOVERY_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-latest,gemini-3.1-flash-lite
DISCOVERY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
